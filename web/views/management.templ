package views

import (
	"github.com/SiIverAsh/otoha/internal/config"
	"github.com/SiIverAsh/otoha/internal/db"
	"strconv"
)

// Login renders the browser sign-in form.
templ Login(next, username, message string, reset bool) {
	<div class="login-wrap">
		<form
			class="login-card"
			id="login-form"
			method="post"
			action="/login"
			hx-post="/login"
			hx-target="closest .login-wrap"
			hx-swap="outerHTML"
		>
			<h1 style="font-size:15px;margin-bottom:12px;">Otoha · 登录</h1>
			<input type="hidden" name="next" value={ next }/>
			<div class="form-row">
				<label for="login-user">用户名</label>
				<input
					id="login-user"
					name="username"
					autocomplete="username"
					value={ username }
					required
					autofocus?={ message != "" && username == "" }
					style="width:180px;"
				/>
			</div>
			<div class="form-row">
				<label for="login-pwd">密码</label>
				<input
					id="login-pwd"
					name="password"
					type="password"
					required
					autofocus?={ message != "" && username != "" }
					style="width:180px;"
					if message != "" || reset {
						aria-describedby="login-message"
					}
					if reset {
						autocomplete="new-password"
						minlength="4"
					} else {
						autocomplete="current-password"
					}
				/>
			</div>
			if reset {
				<p class="banner-warn" id="login-message" role="alert">检测到迁移账号，请输入新密码完成首次设密（至少 4 位）。</p>
			} else if message != "" {
				<p class="banner-warn" id="login-message" role="alert">{ message }</p>
			}
			<button class="primary" type="submit" style="width:100%;">进入媒体库</button>
		</form>
	</div>
}

// History renders the signed-in user's listening sessions.
templ History(ageMode string, rows []HistoryRow) {
	<div class="page-heading"><div><h1>最近播放</h1></div></div>
	<div class="filter-strip">
		<span style="color:var(--muted);">收听会话历史（30 分钟内自动聚合 · 当前分级过滤：{ ageMode }）</span>
		<div style="margin-left:auto;display:flex;gap:6px;">
			<button
				type="button"
				hx-delete={ historyDeleteURL("/ui/history", ageMode, 7) }
				hx-target="#page-content"
				hx-swap="innerHTML"
			>清除近 7 天</button>
			<button
				type="button"
				class="danger"
				hx-delete={ historyDeleteURL("/ui/history", ageMode, 0) }
				hx-target="#page-content"
				hx-swap="innerHTML"
				hx-confirm="确认清空全部收听历史并执行 SQLite VACUUM？"
			>
				清空全部历史并压缩数据库 (VACUUM)
			</button>
		</div>
	</div>
	<div class="table-scroll">
		<table class="compact-table">
			<thead>
				<tr>
					<th style="width:98px;">作品号</th>
					<th style="width:62px;">分级</th>
					<th>作品标题</th>
					<th style="width:200px;">续播音轨</th>
					<th style="width:88px;">续播位置</th>
					<th style="width:88px;">实听时长</th>
					<th style="width:155px;">最后收听</th>
					<th style="width:110px;">操作</th>
				</tr>
			</thead>
			<tbody>
				if len(rows) == 0 {
					<tr><td colspan="8" style="text-align:center;color:var(--muted);padding:24px;">暂无收听记录</td></tr>
				}
				for _, row := range rows {
					@historyRow(ageMode, row)
				}
			</tbody>
		</table>
	</div>
}

templ historyRow(ageMode string, row HistoryRow) {
	<tr>
		<td class="mono">{ row.Entry.Workno }</td>
		<td>@AgeBadge(row.Entry.AgeCategory)</td>
		<td class="work-title-cell">{ row.Entry.WorkTitle }</td>
		<td title={ row.Entry.TrackName }>
			if row.Entry.TrackName == "" {
				-
			} else {
				{ row.Entry.TrackName }
			}
		</td>
		<td class="mono">{ FormatDuration(row.Entry.Position) }</td>
		<td class="mono">{ FormatDuration(row.Entry.Listened) }</td>
		<td class="mono">
			if row.Entry.LastAt == 0 {
				-
			} else {
				<time datetime={ historyDateTime(row.Entry.LastAt) } data-history-time={ strconv.FormatInt(row.Entry.LastAt, 10) }>
					{ historyTime(row.Entry.LastAt) }
				</time>
			}
		</td>
		<td>
			<button type="button" data-action="resume-history" data-entry={ row.ResumeJSON } aria-label={ "续播 " + row.Entry.WorkTitle }>续播</button>
			<button
				type="button"
				class="danger"
				aria-label={ "删除 " + row.Entry.WorkTitle + " 的收听记录" }
				hx-delete={ historyDeleteURL("/ui/history/"+strconv.FormatInt(row.Entry.ID, 10), ageMode, 0) }
				hx-target="#page-content"
				hx-swap="innerHTML"
			>删除</button>
		</td>
	</tr>
}

// Settings renders preferences and the administration dashboard.
templ Settings(page SettingsPage) {
	<div class="page-heading"><div><h1>设置与存储</h1></div></div>
	<div class="settings-page">
		@settingsPreferences(page.Config)
		<section class="settings-panel" aria-labelledby="settings-library">
			<h2 id="settings-library">媒体库管理</h2>
			@settingsStorage(page.Storages)
			<details class="settings-section" id="settings-asmrone">
				<summary>ASMR.one 同步</summary>
				<div class="settings-fields" id="asmrone-checkpoint" hx-sync="this:replace">
					@settingsCheckpoint(page.Task)
				</div>
			</details>
			@settingsASMR18(page.Task)
			if page.CanAdmin {
				@settingsAccounts(page.Users)
			}
			<details class="settings-section" id="settings-maintenance">
				<summary>备份与索引</summary>
				<div class="settings-fields">
					<div class="settings-actions">
						<a class="settings-link" href="/api/export/metadata" target="_blank" rel="noopener" hx-boost="false">导出元数据 JSON</a>
						<button type="button" data-action="reindex-bleve">重建全文索引</button>
					</div>
					<label class="settings-field">
						导入元数据 JSON
						<input type="file" id="import-meta-file" accept=".json"/>
					</label>
				</div>
			</details>
		</section>
	</div>
}

templ settingsPreferences(settings config.Config) {
	<section class="settings-panel" aria-labelledby="settings-preferences">
		<h2 id="settings-preferences">偏好设置</h2>
		<div class="settings-fields settings-panel-body">
			<label class="settings-row">
				默认仅显示全年龄作品
				<input type="checkbox" id="cfg-hide-nsfw" checked?={ settings.DefaultHideNSFW }/>
			</label>
			<label class="settings-row">
				记录收听历史
				<input type="checkbox" id="cfg-history-enabled" checked?={ settings.HistoryEnabled }/>
			</label>
		</div>
		<details class="settings-section" id="settings-playback">
			<summary>播放与历史</summary>
			<div class="settings-fields">
				<label class="settings-row">
					历史保留天数
					<input type="number" id="cfg-hist-days" value={ strconv.Itoa(settings.HistoryMaxDays) }/>
				</label>
				<label class="settings-row">
					历史保留条数
					<input type="number" id="cfg-hist-entries" value={ strconv.Itoa(settings.HistoryMaxEntries) }/>
				</label>
				<label class="settings-row">
					播放心跳间隔（秒）
					<input type="number" id="cfg-hb-sec" value={ strconv.Itoa(settings.HeartbeatIntervalSec) }/>
				</label>
			</div>
		</details>
		<details class="settings-section" id="settings-scraping">
			<summary>抓取与扫描</summary>
			<div class="settings-fields">
				<div class="settings-row">
					<label for="cfg-locale">元数据语言</label>
					<select id="cfg-locale" aria-label="抓取语言">
						for _, locale := range []string{"zh_cn", "ja_jp", "zh_tw", "en_us", "ko_kr"} {
							<option value={ locale } selected?={ settings.ScraperLocale == locale }>{ locale }</option>
						}
					</select>
				</div>
				<label class="settings-field">
					抓取代理（HTTP / SOCKS5）
					<input id="cfg-proxy" value={ settings.ScraperProxy } placeholder="socks5://127.0.0.1:1080"/>
				</label>
				<label class="settings-row">
					抓取固定间隔（秒）
					<input type="number" step="0.5" id="cfg-interval" value={ strconv.FormatFloat(settings.ScraperIntervalSec, 'f', -1, 64) }/>
				</label>
				<label class="settings-row">
					使用 ASMR.one 补齐元数据
					<input type="checkbox" id="cfg-asmrone" checked?={ settings.AsmrOneEnabled }/>
				</label>
				<label class="settings-row">
					最大扫描深度
					<input type="number" id="cfg-depth" value={ strconv.Itoa(settings.ScanMaxDepth) }/>
				</label>
			</div>
		</details>
		<details class="settings-section" id="settings-access">
			<summary>访问与认证</summary>
			<div class="settings-fields">
				<label class="settings-row">
					启用只读 WebDAV (/dav/)
					<input type="checkbox" id="cfg-webdav" checked?={ settings.WebDAVEnabled }/>
				</label>
				<label class="settings-row">
					开启多用户登录认证
					<input type="checkbox" id="cfg-auth" checked?={ settings.AuthEnabled }/>
				</label>
			</div>
		</details>
		<footer class="settings-footer">
			<button class="primary" type="button" data-action="save-settings">保存设置</button>
		</footer>
	</section>
}

templ settingsStorage(storages []db.Storage) {
	<details class="settings-section" id="settings-storage">
		<summary>存储与扫描</summary>
		<div class="settings-fields">
			if len(storages) == 0 {
				<p class="settings-note">尚未配置存储目录</p>
			}
			for _, storage := range storages {
				<details class="settings-subsection" id={ storageSectionID(storage) }>
					<summary>{ storage.Name }</summary>
					<div class="settings-fields">
						<p class="settings-note mono">{ storage.Root }</p>
						<div class="settings-actions">
							<button type="button" data-action="scan-storage" data-id={ strconv.FormatInt(storage.ID, 10) }>扫描</button>
							<button type="button" class="danger" data-action="delete-storage" data-id={ strconv.FormatInt(storage.ID, 10) }>移除</button>
						</div>
					</div>
				</details>
			}
			<details class="settings-subsection" id="settings-add-storage">
				<summary>添加本地目录</summary>
				<div class="settings-fields">
					<label class="settings-field">名称<input id="new-st-name" placeholder="Voices"/></label>
					<label class="settings-field">本地绝对路径<input id="new-st-root" placeholder="D:\VOICES"/></label>
					<div class="settings-actions"><button type="button" data-action="add-storage">添加存储</button></div>
				</div>
			</details>
			<div class="settings-actions">
				<button type="button" data-action="scan-all" data-scrape="0">扫描本地文件</button>
				<button type="button" data-action="scan-all" data-scrape="1">扫描并抓取 DLsite 元数据</button>
			</div>
		</div>
	</details>
}

templ settingsAccounts(users []db.User) {
	<details class="settings-section" id="settings-users">
		<summary>用户账号</summary>
		<div class="settings-fields">
			if len(users) > 0 {
				<p class="settings-note">当前用户：{ accountNames(users) }</p>
			}
			<label class="settings-field">用户名<input id="new-user-name" autocomplete="username"/></label>
			<label class="settings-field">密码（至少 4 位）<input id="new-user-pwd" type="password" autocomplete="new-password"/></label>
			<label class="settings-row">管理员<input type="checkbox" id="new-user-admin" checked/></label>
			<div class="settings-actions"><button type="button" data-action="create-user">保存账号</button></div>
		</div>
	</details>
}

templ settingsASMR18(task SettingsTask) {
	<details class="settings-section" id="settings-asmr18">
		<summary>ASMR18 作品与播放源</summary>
		<div class="settings-fields">
			<label class="settings-field">
				作品页面（每行一个）
				<textarea id="asmr18-urls" rows="3" placeholder="https://asmr18.fans/allages/rj01752865/"></textarea>
			</label>
			<div class="settings-actions">
				<button type="button" data-action="asmr18-preview">预览解析</button>
				<button type="button" data-action="asmr18-import">导入作品</button>
			</div>
			<div id="asmr18-preview-result">
				@settingsPreview(task)
			</div>
			<details class="settings-subsection" id="settings-asmr18-category">
				<summary>按分类采集</summary>
				<div class="settings-fields">
					<div class="settings-row">
						<label for="asmr18-category">分类</label>
						<select id="asmr18-category" aria-label="ASMR18 采集分类">
							<option value="allages">全年龄</option>
							<option value="boys">男性向</option>
							<option value="girls">女性向</option>
						</select>
					</div>
					<label class="settings-row">
						更新已导入的播放地址
						<input id="asmr18-refresh" type="checkbox"/>
					</label>
					<div class="settings-actions"><button type="button" data-action="asmr18-latest">采集最新一页（最多 24 部）</button></div>
				</div>
			</details>
			<details class="settings-subsection" id="settings-asmr18-options">
				<summary>采集参数</summary>
				<div class="settings-fields">
					<label class="settings-row">
						同时采集的作品数
						<input id="asmr18-workers" type="number" min="1" max="16" value="4"/>
					</label>
					<label class="settings-row">
						全局请求间隔（秒）
						<input id="asmr18-interval" type="number" min="0" step="0.25" value="0.5"/>
					</label>
					<label class="settings-row">
						读取时长（增加请求数）
						<input id="asmr18-probe" type="checkbox"/>
					</label>
				</div>
			</details>
		</div>
	</details>
}

// SettingsTaskUpdate renders both task panels for an HTMX fragment request.
templ SettingsTaskUpdate(task SettingsTask) {
	@settingsCheckpoint(task)
	<div id="asmr18-preview-result" hx-swap-oob="innerHTML">
		@settingsPreview(task)
	</div>
}

templ settingsCheckpoint(task SettingsTask) {
	if checkpoint := task.Checkpoint; checkpoint != nil {
		<p class="settings-note">
			已同步第 { strconv.Itoa(checkpoint.CurrentPage) } / { countLabel(checkpoint.TotalPages) } 页。
			总库 { countLabel(checkpoint.TotalCount) } 部，新增 { strconv.Itoa(checkpoint.Inserted) } 部，
			跳过 { strconv.Itoa(checkpoint.Duplicates) } 部，失败 { strconv.Itoa(checkpoint.Failures) } 部。
		</p>
		<p class="settings-note">
			字段完整度：社团 { strconv.FormatFloat(checkpoint.Completeness.CircleRatePct, 'f', -1, 64) }%
			· 声优 { strconv.FormatFloat(checkpoint.Completeness.VARatePct, 'f', -1, 64) }%
			· 标签 { strconv.FormatFloat(checkpoint.Completeness.TagsRatePct, 'f', -1, 64) }%
			· 封面 { strconv.FormatFloat(checkpoint.Completeness.CoverRatePct, 'f', -1, 64) }%
		</p>
		<p class="settings-note">
			{ strconv.FormatFloat(checkpoint.WorksPerSec, 'f', -1, 64) } 部/s · 下次从第 { strconv.Itoa(max(checkpoint.NextPage, 1)) } 页继续
			if checkpoint.ETASeconds > 0 {
				· 预计剩余 { FormatDuration(float64(checkpoint.ETASeconds)) }
			}
		</p>
	} else if task.CheckpointUnavailable {
		<p class="settings-note">无法读取同步断点。</p>
	}
	<div class="settings-actions">
		<button type="button" data-action="sync-asmrone-full">
			if task.Checkpoint != nil {
				继续全站同步
			} else {
				开始全站同步
			}
		</button>
		<button type="button" data-action="sync-asmrone-latest">同步最新 200 部</button>
	</div>
}

templ settingsPreview(task SettingsTask) {
	if task.PreviewJSON != "" {
		<details class="settings-subsection" open>
			<summary>解析结果 · { task.PreviewWorkno } · { task.PreviewTitle }</summary>
			<div class="settings-fields"><pre class="settings-preview">{ task.PreviewJSON }</pre></div>
		</details>
	}
}
